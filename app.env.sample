# Statping-NG - Status page monitoring
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Hostname
BASE_HOST_NAME=$HOSTNAME

# Admin credentials
APP_ADMIN_USER=admin
APP_ADMIN_PASS=changeme_admin_password
APP_ADMIN_EMAIL=admin@example.com

# App name displayed on status page
APP_NAME=Statping
APP_DESCRIPTION=Status page for monitoring

# Database connection (sqlite, postgres, mysql)
DB_CONN=sqlite
